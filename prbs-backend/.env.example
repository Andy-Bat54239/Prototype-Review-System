# prbs-backend — environment template
#
# Copy this file to `.env` (which is gitignored) and fill in real values.
# Load it before starting the app:
#
#   cd prbs-backend
#   set -a; source .env; set +a
#   mvn spring-boot:run
#
# The `set -a` flag tells bash/zsh to export every variable defined below so
# Spring Boot's @Value("${...}") placeholders can read them.
#
# Defaults in application.yml point at Mailpit / H2 / dev secrets so the app
# runs out of the box; only set the variables you actually want to override.

# ──────────────────────────────────────────────────────────────────────────
# JWT (override before any non-local deploy — startup logs WARN otherwise)
# ──────────────────────────────────────────────────────────────────────────
# Must be at least 32 chars. Generate with: openssl rand -base64 48
JWT_SECRET=

# ──────────────────────────────────────────────────────────────────────────
# Mail — pick ONE provider block below and uncomment its lines
# ──────────────────────────────────────────────────────────────────────────

# --- Option A: Outlook / Hotmail (consumer accounts) ---------------------
# Requires 2-Step Verification + an App Password from
# https://account.microsoft.com/security → Advanced security options
#
# MAIL_HOST=smtp-mail.outlook.com
# MAIL_PORT=587
# MAIL_USERNAME=you@outlook.com
# MAIL_PASSWORD=your-16-char-app-password
# MAIL_SMTP_AUTH=true
# MAIL_SMTP_STARTTLS=true
# MAIL_FROM=you@outlook.com

# --- Option B: Gmail -----------------------------------------------------
# Requires 2FA + App Password from https://myaccount.google.com/apppasswords
#
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=you@gmail.com
# MAIL_PASSWORD=your-16-char-app-password
# MAIL_SMTP_AUTH=true
# MAIL_SMTP_STARTTLS=true
# MAIL_FROM=you@gmail.com

# --- Option C: SendGrid (matches the original P2 spec, production-grade) -
# 1. https://app.sendgrid.com/settings/api_keys → create a key with Mail Send
# 2. https://app.sendgrid.com/settings/sender_auth → verify a sender address
#
# MAIL_HOST=smtp.sendgrid.net
# MAIL_PORT=587
# MAIL_USERNAME=apikey
# MAIL_PASSWORD=SG.your-api-key-here
# MAIL_SMTP_AUTH=true
# MAIL_SMTP_STARTTLS=true
# MAIL_FROM=noreply@your-verified-domain.com

# ──────────────────────────────────────────────────────────────────────────
# CORS — comma-separated origins allowed to hit /api/**
# ──────────────────────────────────────────────────────────────────────────
# CORS_ALLOWED_ORIGINS=http://localhost:5173,https://prbs.auca.ac.rw

# ──────────────────────────────────────────────────────────────────────────
# Postgres (only needed with --spring.profiles.active=postgres)
# ──────────────────────────────────────────────────────────────────────────
# DB_URL=jdbc:postgresql://localhost:5432/prbs
# DB_USER=prbs
# DB_PASSWORD=
